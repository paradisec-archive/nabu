{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "workspaces": {
    ".": {
      "entry": [
        // esbuild bundles these
        "app/javascript/*.{js,ts}",
        // served unbundled by Propshaft
        "app/javascript/custom/advanced_search.js",
        // loaded via @config in active_admin.css
        "tailwind-active_admin.config.mjs"
      ],
      "project": ["app/javascript/**/*.{js,ts}", "*.{js,mjs,ts}"],
      // the glob in the esbuild build script
      "ignoreUnresolved": ["app/javascript/\\*\\.\\*"],
      // pulled in by `@import "tailwindcss"` in active_admin.css
      "ignoreDependencies": ["tailwindcss"]
    },
    "cdk": {
      "entry": ["bin/app.ts"],
      "project": ["{bin,lib}/**/*.ts"],
      "ignoreDependencies": [
        // cdk.json runs `tsx bin/app.ts`
        "tsx",
        // bin/release runs it
        "cdk-agc"
      ]
    },
    "cdk/docker/mediaflux": {
      "entry": [
        // Dockerfile CMD
        "archive.ts",
        // run by the ECS task in cdk/lib/app-stack.ts
        "inventory.ts"
      ],
      "project": ["*.ts"]
    }
  }
}
