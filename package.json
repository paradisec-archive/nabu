{
  "name": "nabu",
  "private": true,
  "dependencies": {
    "@activeadmin/activeadmin": "4.0.0-beta23",
    "@googlemaps/js-api-loader": "^2.1.3",
    "@googlemaps/markerclusterer": "^2.6.2",
    "@sentry/browser": "^11.12.0",
    "choices.js": "^11.2.4",
    "sass": "^1.108.1",
    "tailwindcss": "^4.3.5"
  },
  "scripts": {
    "build": "esbuild app/javascript/*.* --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets",
    "build:css": "pnpm build:css_app && pnpm build:css_active_admin",
    "build:css_app": "sass ./app/assets/stylesheets/application.sass.scss:./app/assets/builds/application.css --no-source-map --load-path=node_modules",
    "build:css_active_admin": "pnpm dlx @tailwindcss/cli -i ./app/assets/stylesheets/active_admin.css -o ./app/assets/builds/active_admin.css --minify",
    "lint:biome": "biome check .",
    "lint:knip": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "esbuild": "^0.28.2",
    "knip": "^6.45.0",
    "lefthook": "^2.2.2"
  },
  "packageManager": "pnpm@12.18.0"
}
