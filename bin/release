#!/usr/bin/env bash

set -e

ENV=$1
if [ -z "$ENV" ]; then
  echo "Usage: bin/release <stage|prod> [--branch]"
  exit 1
fi

BRANCH_DEPLOY=false
if [ "$2" == "--branch" ]; then
  if [ "$ENV" != "stage" ]; then
    echo "--branch deploys are only allowed to stage"
    exit 1
  fi
  BRANCH_DEPLOY=true
fi

# Make sure we have creds before merging so the close issue logic works
AWS_PROFILE=nabu-${ENV} aws sts get-caller-identity >/dev/null

if [ "$BRANCH_DEPLOY" != "true" ]; then
  LAST_DEPLOY_COMMIT=$(git rev-parse origin/prod)

  git push
  git switch "$ENV"
  git pull
  git merge --ff-only main
  git push
  git switch main
fi

# Pull docker images for the new release
docker pull node:lts-alpine
docker pull ubuntu:24.04
docker pull ghcr.io/crate-works/oni:latest
docker pull ghcr.io/crate-works/downloader:latest

cd cdk
AWS_PROFILE=nabu-${ENV} pnpm cdk deploy "nabu-appstack-${ENV}"

# Services using mutable registry tags don't redeploy via CDK, so force new deployments
DEPLOYMENT_ID=$(AWS_PROFILE=nabu-${ENV} aws ecs update-service --cluster nabu --service downloader --force-new-deployment --no-cli-pager \
  --query 'service.deployments[?status==`PRIMARY`].id' --output text)
echo "Forced new deployment of downloader service ($DEPLOYMENT_ID), waiting for it to become stable..."

# Each wait is capped at 10 minutes by the CLI, so retry a few times for slower rollouts
DOWNLOADER_STABLE=false
for _ in 1 2 3; do
  if AWS_PROFILE=nabu-${ENV} aws ecs wait services-stable --cluster nabu --services downloader; then
    DOWNLOADER_STABLE=true
    break
  fi
  echo "Downloader service still deploying..."
done

if [ "$DOWNLOADER_STABLE" != "true" ]; then
  echo "Downloader service did not become stable after 30 minutes"
  exit 1
fi

ROLLOUT_STATE=$(AWS_PROFILE=nabu-${ENV} aws ecs describe-services --cluster nabu --services downloader --no-cli-pager \
  --query "services[0].deployments[?id=='$DEPLOYMENT_ID'].rolloutState" --output text)
if [ "$ROLLOUT_STATE" != "COMPLETED" ]; then
  echo "Downloader deployment $DEPLOYMENT_ID finished in state '${ROLLOUT_STATE:-UNKNOWN}', not COMPLETED"
  exit 1
fi

echo "Downloader service deployed"

# Cleanup cdk
# Echo cleaning up!!
pnpm exec cdk-agc

if [ "$ENV" != "prod" ]; then
  exit
fi

echo "Last deploy was commit on prod: $LAST_DEPLOY_COMMIT"

# Get commits since the last merge
COMMITS=$(git log "$LAST_DEPLOY_COMMIT"..HEAD --oneline)
if [ -z "$COMMITS" ]; then
  echo "No new commits since the last merge to prod."
  exit 0
fi

echo "Commits since the last merge:"
echo "$COMMITS"

# Extract GitHub issue references (e.g., #123)
ISSUES=$(echo "$COMMITS" | grep -oE "#[0-9]+" | sort -u)
if [ -z "$ISSUES" ]; then
  echo "No GitHub issues referenced in commits."
  exit 0
fi

echo "Referenced issues:"
echo "$ISSUES"

# Prompt to close each issue
for ISSUE in $ISSUES; do
  ISSUE_NUMBER=${ISSUE#"#"} # Remove the # symbol
  echo "Would you like to close issue #$ISSUE_NUMBER? (y/n)"
  read -r RESPONSE

  if [[ "$RESPONSE" =~ ^[Yy]$ ]]; then
    echo "Closing issue #$ISSUE_NUMBER..."
    gh issue close "$ISSUE_NUMBER" --repo paradisec-archive/nabu
  else
    echo "Skipping issue #$ISSUE_NUMBER."
  fi
done

echo "Done!"
