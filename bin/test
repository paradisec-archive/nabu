#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

export RAILS_ENV='test'

# Skip test:prepare's slow JavaScript install and asset builds when the builds are current
build=app/assets/builds/application.css
if [ -f "$build" ] && [ -z "$(find app/javascript app/assets/stylesheets package.json pnpm-lock.yaml -newer "$build" -print -quit)" ]; then
  export SKIP_JS_BUILD=1 SKIP_CSS_BUILD=1
fi

bin/rails db:prepare test:prepare

# Any argument (paths, --only-failures, --seed) runs plain RSpec in one process
[ $# -eq 0 ] || exec bundle exec rspec "$@"

# Several agents share a developer's machine, so cap the workers. A caller that owns the
# machine, such as CI, passes its own count.
export PARALLEL_TEST_PROCESSORS="${PARALLEL_TEST_PROCESSORS:-4}"

bundle exec parallel_test --exec 'bin/rails db:prepare'
exec bundle exec parallel_rspec --serialize-stdout --combine-stderr \
  --test-options '--format progress --format ParallelTests::RSpec::RuntimeLogger --out tmp/parallel_runtime_rspec.log'
