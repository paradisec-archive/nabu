- { 'new' => 'Added', 'updated' => 'Updated' }.each do |which, heading|
  %h3= heading
  - essences = data[:"#{which}_essences"]
  %ul{class: 'list-disc'}
    %li{class: 'list-inside'}== #{data[:"#{which}_collections"].size} Collections
    %li{class: 'list-inside'}== #{data[:"#{which}_items"].size} Items
    %li{class: 'list-inside'}== #{essences.size} Files
    %li{class: 'list-inside'}== #{number_to_human_size essences.sum { |essence| essence.size || 0 }}
    %li{class: 'list-inside'}== #{number_to_human_duration essences.sum { |essence| essence.duration || 0 }} Hours
