aggs = @search.aggs.reject { |agg| agg == 'location' }

result = {
  total: @search.total_count,
  searchTime: @search.took,
  entities: @search.with_highlights.map.with_index do |value, index|
    entity, highlights = value
    hit = @search.hits[index]
    render(partial: 'entity', locals: { entity: entity.entity, highlights:, hit:, score: hit.dig('_score'), essence_terms_required: @essence_terms_required })
  end,
  facets: aggs.to_h do |name, agg|
    buckets = agg['buckets'].map do |bucket|
      key = name == 'entity_type' ? Oni::EntityType.to_public(bucket['key']) : bucket['key']

      { name: key, count: bucket['doc_count'] }
    end

    [name, buckets]
  end
}

location_agg = @search.aggs.find { |agg| agg[0] == 'location' }
if location_agg
  result[:geohashGrid] = location_agg[1]['buckets'].to_h { |item| [item['key'], item['doc_count']] }
end

result
